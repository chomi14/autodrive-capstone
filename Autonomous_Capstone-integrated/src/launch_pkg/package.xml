<?xml version="1.0"?>
<package format="3">
  <name>launch_pkg</name>
  <version>0.1.0</version>
  <description>Integrated SKKU autonomous vehicle mission launch files</description>
  <maintainer email="noreply@example.com">skku</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>sensor_bringup_pkg</exec_depend>
  <exec_depend>camera_perception_pkg</exec_depend>
  <exec_depend>lidar_perception_pkg</exec_depend>
  <exec_depend>decision_making_pkg</exec_depend>
  <exec_depend>vehicle_io_pkg</exec_depend>
  <exec_depend>vehicle_bringup_pkg</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
